# Copy this file to `.env` and fill in your real key.
# Get a FREE key at https://openrouter.ai/keys (sign up, no credit card needed
# for free-tier models).
# NEVER commit the real .env file to GitHub.

OPENROUTER_API_KEY=your api key here

# Which model powers the assistant. Free models on OpenRouter are tagged
# with ":free" — check https://openrouter.ai/models for the current list.
OPENROUTER_MODEL=google/gemma-4-31b-it:free